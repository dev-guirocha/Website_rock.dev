---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import p from '../textos/projetos.json';
import { t } from '../lib/i18n.js';

const { lang } = Astro.props;
---
<Base lang={lang} rota="projetos/" titulo={t(p.meta.titulo, lang)} descricao={t(p.meta.descricao, lang)}>
  <section class="container secao">
    <p class="rotulo">{t(p.rotulo, lang)}</p>
    <h1>{t(p.titulo, lang)}</h1>
    <p class="lead">{t(p.texto, lang)}</p>
    <div class="grade">{p.itens.map((projeto) => <ProjectCard lang={lang} projeto={projeto} />)}</div>
  </section>
</Base>
