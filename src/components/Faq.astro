---
import { t } from '../lib/i18n.js';

const { lang, itens } = Astro.props;
---
<div class="faq">
  {itens.map((i) => (
    <details>
      <summary>{t(i.pergunta, lang)}</summary>
      <p>{t(i.resposta, lang)}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 12px; max-width: 760px; }
  details { background: var(--superficie); border: 1px solid var(--borda); border-radius: var(--raio); padding: 0 20px; }
  summary { cursor: pointer; font-weight: 600; padding: 14px 0; min-height: 44px; }
  details p { color: var(--texto-suave); }
</style>
